Bài 9 – Set: Tập hợp số nguyên
list1 = list(map(int, input("Nhap danh sach so nguyen thu nhat: ").split()))
list2 = list(map(int, input("Nhap danh sach so nguyen thu hai: ").split()))

set1 = set(list1)
set2 = set(list2)

print("Tap hop thu nhat:", set1)
print("Tap hop thu hai:", set2)
print("Giao hai tap hop:", set1 & set2)
print("Hieu tap hop thu nhat:", set1 - set2)
print("Hop hai tap hop:", set1 | set2)
Bài 10 – Ứng dụng tổng hợp: Quản lý lớp học
lop_hoc = {
    "Nguyen Van A": 8.5,
    "Tran Thi B": 7.5,
    "Le Van C": 9.0
}

for i in range(3):
    name = input(f"Nhap ten hoc sinh thu {i + 1}: ")
    score = float(input("Nhap diem: "))

    lop_hoc[name] = score

average = sum(lop_hoc.values()) / len(lop_hoc)

print("Diem trung binh cua lop:", average)

print("Danh sach hoc sinh co diem lon hon 8:")

for name, score in lop_hoc.items():
    if score > 8:
        print(f"{name}: {score}")

sorted_students = sorted(
    lop_hoc.items(),
    key=lambda student: student[1],
    reverse=True
)

print("Danh sach hoc sinh theo diem giam dan:")

for name, score in sorted_students:
    print(f"{name}: {score}")
