Bài 1 – Tính số lớn nhất
def tim_max(a, b, c):
    return max(a, b, c)


a = float(input("Nhap so thu nhat: "))
b = float(input("Nhap so thu hai: "))
c = float(input("Nhap so thu ba: "))

max_value = tim_max(a, b, c)

print("So lon nhat:", max_value)

if max_value % 2 == 0:
    print("So lon nhat la so chan")
else:
    print("So lon nhat khong phai so chan")

if max_value % 3 == 0:
    print("Chia het cho 3")
else:
    print("Khong chia het cho 3")

if max_value < 0:
    print("So am")
elif max_value > 0:
    print("So duong")
else:
    print("Bang 0")
Bài 2 – Tính tổng số chẵn
def tong_chan(n):
    total = 0

    for i in range(2, n + 1, 2):
        total += i

    return total


n = int(input("Nhap so nguyen duong n: "))

if n <= 0:
    print("Vui long nhap so nguyen duong")
else:
    total = tong_chan(n)

    print("Tong cac so chan:", total)

    if total > 100:
        print("Tong lon")
    else:
        print("Tong nho")

    print("Cac so chan tu 1 den", n, "la:")

    for i in range(2, n + 1, 2):
        print(i, end=" ")

    print()
